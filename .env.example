# Persistent control plane
DATABASE_URL=postgres://trialrun:trialrun@127.0.0.1:55432/trialrun
APP_URL=http://localhost:3000
NODE_ENV=development

# Generate with: openssl rand -base64 32
CSRF_SECRET_BASE64=
VAULT_KEY_BASE64=
VAULT_KEY_VERSION=1

# local | zerops
EXECUTION_PROVIDER=local
ARTIFACT_DRIVER=local
ARTIFACT_ROOT=.data/artifacts

# Runner. Omit RUNNER_ID to generate a unique process identity.
# RUNNER_ID=my-runner-instance
RUNNER_POLL_MS=750
RUNNER_LEASE_SECONDS=90
RUNNER_JOB_TIMEOUT_SECONDS=900

# Repository analysis and the live test pilot use either the managed key or an
# isolated, already-authenticated Codex home. TrialRun never copies auth.json.
CODEX_ANALYST_ENABLED=true
CODEX_BINARY=codex
MANAGED_OPENAI_API_KEY=
MANAGED_CODEX_HOME=

# GitHub App. Base64-encode the complete PEM, including its header and footer.
GITHUB_APP_ID=4526353
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_CLIENT_ID=Iv23liwKU1sADhXQAAiw
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Zerops API (required only when EXECUTION_PROVIDER=zerops)
TRIALRUN_ZEROPS_API_URL=https://api.app-prg1.zerops.io/api/rest/public
TRIALRUN_ZEROPS_ACCESS_TOKEN=
TRIALRUN_ZEROPS_CLIENT_ID=
TRIALRUN_ZEROPS_EXECUTOR_SOURCE_DIRECTORY=.
TRIALRUN_CODEX_WORKSPACE_SOURCE_DIRECTORY=.
# Base64 of an Ed25519 PKCS8 private key. The customer workspace receives only its public key.
TRIALRUN_BRIDGE_SIGNING_PRIVATE_KEY_BASE64=
ZCLI_BINARY=zcli

# S3-compatible persistent evidence (required when ARTIFACT_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=trialrun-evidence
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
