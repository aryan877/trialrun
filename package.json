{
  "name": "trialrun",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint && eslint scripts --max-warnings=0",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:generate": "pnpm --filter @trialrun/db generate",
    "db:migrate": "pnpm --filter @trialrun/db migrate",
    "db:seed": "pnpm --filter @trialrun/db seed",
    "live:render-import": "tsx scripts/render-live-import.ts",
    "web:artifact:linux": "tsx scripts/build-web-artifact.ts",
    "web:artifact:verify": "tsx scripts/verify-web-artifact.ts",
    "web:artifact:deploy": "tsx scripts/deploy-web-artifact.ts",
    "runner": "pnpm --filter @trialrun/runner start"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@node-rs/argon2": "2.0.2",
    "@playwright/test": "1.62.1",
    "@types/node": "22.15.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.3.0",
    "globals": "16.4.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "tsx": "4.23.11",
    "turbo": "2.10.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
